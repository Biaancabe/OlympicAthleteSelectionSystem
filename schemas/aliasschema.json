{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CompetitionAliases",
    "type": "object",
    "required": ["version", "aliases"],
    "additionalProperties": false,
    "properties": {
        "version": {
            "type": "integer",
            "minimum": 1
        },
        "aliases": {
            "type": "object",
            "description": "sport name -> { rule competition name -> [data competition name, ...] }",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                    "type": "array",
                    "items": {"type": "string"},
                    "minItems": 1
                }
            }
        }
    }
}